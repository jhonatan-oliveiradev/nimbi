{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nimbi",
  "version": "0.1.0",
  "identifier": "dev.jhonatan.nimbi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "Nimbi",
        "width": 640,
        "height": 300,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
